#include <Arduino.h> // Essential for PlatformIO
#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN  21  // SDA Pin
#define RST_PIN 22  // Reset Pin

MFRC522 mfrc522(SS_PIN, RST_PIN);

void setup() {
  Serial.begin(115200);
  while (!Serial);      

  SPI.begin();           
  mfrc522.PCD_Init();    
  delay(4);             

  Serial.println(F("**********************************"));
  mfrc522.PCD_DumpVersionToSerial();
  Serial.println(F("Scan a card to see the UID..."));
  Serial.println(F("**********************************"));
}

void loop() {
  // Reset loop if no new card is present
  if (!mfrc522.PICC_IsNewCardPresent()) {
    return;
  }

  // Verify if the UID has been read
  if (!mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  // Dump UID to the Serial Monitor
  Serial.print(F("Card UID:"));
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i] < 0x10 ? " 0" : " ");
    Serial.print(mfrc522.uid.uidByte[i], HEX);
  }
  Serial.println();

  // Halt PICC to stop redundant reading
  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
}